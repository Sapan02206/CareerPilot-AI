# AI Resume Analyzer v3.0 — Environment Variables
# Copy this file to .env and fill in your values
# Never commit .env to version control

# ── Flask ──────────────────────────────────────────────────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-strong-secret-key-here

# ── Database ───────────────────────────────────────────────────────────────
# Leave blank to use SQLite (fine for PythonAnywhere free tier)
# For PostgreSQL: postgresql://user:password@localhost:5432/resume_analyzer
DATABASE_URL=

# ── File uploads ───────────────────────────────────────────────────────────
UPLOAD_FOLDER=uploads

# ── Optional: OpenAI integration ──────────────────────────────────────────
# OPENAI_API_KEY=sk-...

# ── Skill matching weights (defaults are fine) ────────────────────────────
# REQUIRED_SKILL_WEIGHT=1.0
# OPTIONAL_SKILL_WEIGHT=0.5
